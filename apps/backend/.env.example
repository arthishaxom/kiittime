# Database
# [required] PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiittime

# Authentication & Security
# [required] Secret key for signing JWT tokens (required in production)
SECRET_KEY=your-secret-key-at-least-32-chars-long

# Email / OTP Delivery
# [required] Resend API key for sending verification OTP emails
RESEND_API_KEY=re_xxxx
# [optional] Sender email address for OTP emails (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=onboarding@resend.dev

# CORS & Server
# [optional] Comma-separated list of allowed CORS origins (default: *)
ALLOWED_ORIGINS=*
# [optional] Redis connection URL for rate limiting and caching (default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
# [optional] Application runtime environment (production | dev, default: dev)
ENVIRONMENT=dev

# Axiom Logging
# [optional] Axiom API key for log forwarding (if omitted, Axiom forwarding is disabled)
AXIOM_API_KEY=
# [optional] Axiom dataset name to send logs to (default: kiittime-backend-logs)
AXIOM_DATASET=kiittime-backend-logs

# Cloudflare R2 Storage (Analytics Gold Tables)
# [optional] Cloudflare R2 access key ID (if omitted, analytics Gold reads are disabled)
R2_ACCESS_KEY=
# [optional] Cloudflare R2 secret access key
R2_SECRET_KEY=
# [optional] Cloudflare account ID for R2 endpoint construction
CF_ACCOUNT_ID=
# [optional] Cloudflare R2 bucket name (default: kiittime-analytics)
R2_BUCKET_NAME=kiittime-analytics
# [optional] Local filesystem path override for Gold tables (useful for local testing)
GOLD_BASE_PATH=
