# Backend API
# [optional] Backend API base URL (default: http://127.0.0.1:8000, set to https://kiittime-backend.onrender.com for production)
VITE_API_BASE_URL=http://127.0.0.1:8000

# PostHog Analytics
# [optional] PostHog project API key for event telemetry (capture disabled if absent)
VITE_POSTHOG_API_KEY=phc_xxxx
# [optional] PostHog ingest host URL (default: https://us.i.posthog.com)
VITE_POSTHOG_HOST=https://us.i.posthog.com
# [optional] Environment name for PostHog capture gating (development | production, falls back to mode/PROD if omitted)
VITE_ENV=development
