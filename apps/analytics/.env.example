# Cloudflare R2 Credentials
# [required] Cloudflare R2 access key ID
R2_ACCESS_KEY=your-r2-access-key-id
# [required] Cloudflare R2 secret access key
R2_SECRET_KEY=your-r2-secret-access-key
# [required] Cloudflare account ID (used to construct R2 S3 endpoint URL)
CF_ACCOUNT_ID=your-cloudflare-account-id
# [optional] Cloudflare R2 bucket name for analytics data (default: kiittime-analytics)
R2_BUCKET_NAME=kiittime-analytics

# Axiom Credentials & Settings
# [required] Axiom API key for querying backend logs
AXIOM_API_KEY=your-axiom-api-key
# [optional] Axiom organization ID (empty for single-org accounts)
AXIOM_ORG_ID=
# [optional] Axiom dataset name to query logs from (default: kiittime-backend-logs)
AXIOM_DATASET=kiittime-backend-logs

# Environment
# [optional] Environment name (default: dev)
ENVIRONMENT=dev

# Analytics Serving Snapshot (ADR-0007)
# [optional] Write-capable PG URL for Gold sync (falls back to DATABASE_URL)
ANALYTICS_WRITER_DATABASE_URL=
# [optional] Analytics pool size, capped at 2 (shared 20-conn budget)
ANALYTICS_POOL_SIZE=2
# [optional] Comma-separated YYYY-MM-DD dates authoritatively empty for PostHog
POSTHOG_EMPTY_DATES=
