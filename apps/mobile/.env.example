# Backend API
# [optional] Backend API base URL (default: https://kiittime-backend.onrender.com, use http://localhost:8000 for local dev)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# PostHog Analytics
# [optional] PostHog project API key for event telemetry (capture disabled if absent)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxx
# [optional] PostHog ingest host URL (default: https://us.i.posthog.com)
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# [optional] Environment name controlling PostHog capture gating (development | production)
EXPO_PUBLIC_ENV=development

# Webapp Share URL
# [optional] Webapp base URL used for timetable share links (default: https://kiittime.apothal.dev)
EXPO_PUBLIC_WEBAPP_URL=https://kiittime.apothal.dev
